{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensource-cortex.dev/conformance/certificate.schema.json",
  "title": "Behavioral certificate",
  "description": "Binds a frozen reference, a corpus, and an implementation that reproduced it. `evidence` is re-derivable and verified by `certify --check`; `release` is historical and carried forward; `buildEnvironment` is recorded but never compared.",
  "type": "object",
  "required": ["artifact", "subject", "releaseTag", "evidence"],
  "properties": {
    "artifact": { "const": "behavioral-certification" },
    "subject": { "type": "string" },
    "kernelVersion": { "type": "string" },
    "releaseTag": { "type": "string" },
    "acceptanceCommand": { "type": "string" },
    "gates": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "object",
      "required": ["referenceCommitSha", "oracleVersion", "canonicalizationVersion", "fixtureCount", "manifest"],
      "properties": {
        "referenceCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "oracleVersion": { "type": "string" },
        "canonicalizationVersion": { "type": "integer" },
        "schemaVersion": { "type": "integer" },
        "fixtureCount": { "type": "integer", "minimum": 1 },
        "manifest": { "$ref": "#/$defs/hashedFile" },
        "invariantVersion": { "type": "object" },
        "canonicalizer": { "$ref": "#/$defs/hashedFile" }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "kernelMergeCommitSha": { "type": ["string", "null"] },
        "certifiedAtCommit": { "type": "string" },
        "workflow": { "type": "object" },
        "releaseTimestamp": { "type": "string" }
      }
    },
    "buildEnvironment": { "type": "object" }
  },
  "$defs": {
    "hashedFile": {
      "type": "object",
      "required": ["sha256"],
      "properties": { "path": { "type": "string" }, "set": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    }
  }
}
