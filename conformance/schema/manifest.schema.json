{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensource-cortex.dev/conformance/manifest.schema.json",
  "title": "Conformance corpus manifest",
  "type": "object",
  "required": ["sourceBaseline", "oracleVersion", "schemaVersion", "canonicalizationVersion", "cases"],
  "properties": {
    "sourceBaseline": { "type": "string", "description": "Commit of the frozen reference the corpus was captured from." },
    "oracleVersion": { "type": "string" },
    "schemaVersion": { "type": "integer" },
    "canonicalizationVersion": { "type": "integer", "description": "Encoding version per CANONICALIZATION.md. Changing it invalidates every hash." },
    "oracleSource": { "type": "string" },
    "limitations": { "type": "string" },
    "note": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["caseId", "category", "fixture", "sha256"],
        "properties": {
          "caseId": { "type": "string" },
          "category": { "type": "string" },
          "fixture": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "expectedStage": { "type": ["string", "null"] },
          "expectedVerdict": { "type": ["string", "null"] },
          "oracleSource": { "type": "string" }
        }
      }
    },
    "blockers": { "type": "array" }
  }
}
